Windows Registry Editor Version 5.00

; Preconfigured PuTTY sessions for the CGN & Telemetry training lab.
; Imported (current user only, no administrator rights) by scripts\start.ps1.
; COLLECTOR is reached directly; every device is reached THROUGH the COLLECTOR with PuTTY's own
; "SSH to proxy and use port forwarding" (ProxyMethod 6): no extra software, no tunnels to configure.
; Lab accounts are public in the guides (cisco/cisco), so they are stored on purpose.

[HKEY_CURRENT_USER\Software\SimonTatham\PuTTY\Sessions\COLLECTOR]
"HostName"="198.18.128.3"
"PortNumber"=dword:00000016
"Protocol"="ssh"
"UserName"="cisco"
"ScrollbackLines"=dword:00002710
"WinTitle"="COLLECTOR (jump host)"

[HKEY_CURRENT_USER\Software\SimonTatham\PuTTY\Sessions\CORE]
"HostName"="10.250.0.11"
"PortNumber"=dword:00000016
"Protocol"="ssh"
"UserName"="cisco"
"ScrollbackLines"=dword:00002710
"WinTitle"="CORE"
"Cipher"="aesgcm,chacha20,aes,3des,WARN,des,arcfour"
"ProxyMethod"=dword:00000006
"ProxyHost"="198.18.128.3"
"ProxyPort"=dword:00000016
"ProxyUsername"="cisco"
"ProxyPassword"="cisco"

